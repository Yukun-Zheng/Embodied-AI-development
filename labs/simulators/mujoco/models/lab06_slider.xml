<mujoco model="lab06_slider">
  <compiler angle="radian"/>
  <option timestep="0.002" gravity="0 0 0" integrator="RK4"/>

  <worldbody>
    <body name="mass_body" pos="0 0 0">
      <joint name="slide" type="slide" axis="1 0 0" damping="0.2" limited="true" range="-2 2"/>
      <geom name="mass_geom" type="box" size="0.05 0.05 0.05" mass="1.0" rgba="0.3 0.5 0.8 1"/>
    </body>
  </worldbody>

  <actuator>
    <motor name="slider_motor" joint="slide" gear="1" ctrllimited="true" ctrlrange="-20 20"/>
  </actuator>
</mujoco>
